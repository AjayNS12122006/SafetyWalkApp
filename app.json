
{
  "expo": {
    "name": "SafetyWalkApp",
    "slug": "SafetyWalkApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "safetywalkapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.safetywalk.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SafetyWalk needs your location to share it with your trusted contacts during a walk and to send SOS alerts.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SafetyWalk needs your location to keep sharing it with your trusted contacts while a Safety Walk is active."
      }
    },
    "android": {
      "package": "com.safetywalk.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD1p3lNtwgAV-ojgNUFXk1T4plvBCUIKJ0"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "SEND_SMS",
        "CALL_PHONE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SafetyWalk needs your location to share it with your trusted contacts and send SOS alerts."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-asset",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c5118a4b-706d-4f06-b7eb-daae2ed34172"
      }
    }
  }
}
