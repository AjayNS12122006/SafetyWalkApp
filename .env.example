EXPO_PUBLIC_ORS_API_KEY=your-openrouteservice-api-key

# Where the app finds the backend. See lib/config.js for details.
# - Same-machine web testing: leave unset (defaults to http://localhost:4000)
# - Phone + backend on the same Wi-Fi: http://<your-computer-LAN-IP>:4000
# - Real installable APK to hand to other people: a deployed backend URL,
#   e.g. https://your-backend.onrender.com
EXPO_PUBLIC_API_BASE_URL=http://192.168.29.28:4000
